# .env.example
# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
# The pipeline runs without a key: it uses yfinance, which needs none. The key is
# only read if you switch the acquisition path to Alpha Vantage.
ALPHAVANTAGE_API_KEY=your_key_here
DATA_DIR=./data
DATA_DIR_RAW=data/raw
DATA_DIR_PROCESSED=data/processed
